<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>INGENIOUS FIRE ALGERIA | Fire & Weather Monitoring</title>

<meta name="description"
content="INGENIOUS FIRE ALGERIA - Algeria fire detection, satellite hotspots, weather radar and weather monitoring dashboard.">

<meta name="theme-color" content="#07111f">

<link rel="preconnect" href="https://unpkg.com">
<link rel="preconnect" href="https://tile.openstreetmap.org">
<link rel="preconnect" href="https://api.open-meteo.com">

<link
rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
integrity="sha256-p4NxAoJBhIINfQ3FJq8cR0m2F8pF7j7n5eZx9Gm2G0="
crossorigin=""
/>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#050b14;
    --panel:#0b1422;
    --panel2:#101c2d;
    --border:rgba(255,255,255,.09);
    --text:#f5f7fa;
    --muted:#91a0b5;
    --red:#ff202d;
    --red2:#ff4b35;
    --orange:#ff8a00;
    --yellow:#ffd000;
    --blue:#168cff;
    --green:#23d17b;
    --shadow:0 20px 60px rgba(0,0,0,.35);
}

body{
    background:
    radial-gradient(circle at 20% -10%,rgba(255,32,45,.14),transparent 30%),
    radial-gradient(circle at 100% 0%,rgba(22,140,255,.12),transparent 30%),
    var(--bg);
    color:var(--text);
    font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Arial,
    sans-serif;
    min-height:100vh;
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

a{
    color:inherit;
    text-decoration:none;
}

/* ================= HEADER ================= */

header{
    position:sticky;
    top:0;
    z-index:1000;
    backdrop-filter:blur(20px);
    background:rgba(5,11,20,.86);
    border-bottom:1px solid var(--border);
}

.header-inner{
    max-width:1500px;
    margin:auto;
    padding:15px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.brand{
    display:flex;
    align-items:center;
    gap:13px;
}

.logo{
    width:46px;
    height:46px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
    linear-gradient(145deg,#ff3038,#a7000b);
    box-shadow:
    0 0 30px rgba(255,32,45,.3);
    font-size:24px;
}

.brand-title{
    font-weight:900;
    letter-spacing:.8px;
    font-size:17px;
}

.brand-sub{
    color:var(--muted);
    font-size:11px;
    margin-top:2px;
}

.live{
    display:flex;
    align-items:center;
    gap:8px;
    background:rgba(35,209,123,.08);
    border:1px solid rgba(35,209,123,.25);
    padding:8px 12px;
    border-radius:999px;
    font-size:12px;
    color:#8dffbe;
}

.live-dot{
    width:8px;
    height:8px;
    background:#20dc79;
    border-radius:50%;
    box-shadow:0 0 12px #20dc79;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    50%{opacity:.35;transform:scale(.7);}
}

/* ================= MAIN ================= */

.container{
    max-width:1500px;
    margin:auto;
    padding:22px 20px 50px;
}

/* ================= SEARCH ================= */

.searchbar{
    display:grid;
    grid-template-columns:1fr auto auto;
    gap:10px;
    margin-bottom:18px;
}

.search-wrap{
    position:relative;
}

.search-wrap input{
    width:100%;
    height:50px;
    border-radius:15px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.045);
    color:white;
    padding:0 17px;
    outline:none;
}

.search-wrap input:focus{
    border-color:rgba(255,32,45,.6);
    box-shadow:0 0 0 3px rgba(255,32,45,.08);
}

.btn{
    height:50px;
    padding:0 17px;
    border:1px solid var(--border);
    background:var(--panel);
    color:white;
    border-radius:15px;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-1px);
    background:var(--panel2);
}

.btn-red{
    border:0;
    background:linear-gradient(135deg,var(--red),#b8000c);
}

.btn-blue{
    border:0;
    background:linear-gradient(135deg,#168cff,#0759aa);
}

/* ================= HERO WEATHER ================= */

.hero{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:18px;
    margin-bottom:18px;
}

.card{
    background:
    linear-gradient(145deg,
    rgba(255,255,255,.055),
    rgba(255,255,255,.018));
    border:1px solid var(--border);
    border-radius:22px;
    box-shadow:var(--shadow);
}

.weather-main{
    min-height:310px;
    padding:28px;
    overflow:hidden;
    position:relative;
}

.weather-main:after{
    content:"";
    position:absolute;
    width:300px;
    height:300px;
    right:-100px;
    top:-120px;
    border-radius:50%;
    background:rgba(255,32,45,.08);
    filter:blur(10px);
}

.city{
    font-size:15px;
    color:#dbe3ee;
    font-weight:700;
}

.date{
    color:var(--muted);
    margin-top:5px;
    font-size:13px;
}

.temp-row{
    display:flex;
    align-items:center;
    gap:22px;
    margin-top:28px;
}

.weather-icon{
    font-size:72px;
    line-height:1;
}

.temp{
    font-size:76px;
    line-height:.9;
    font-weight:800;
    letter-spacing:-5px;
}

.degree{
    font-size:30px;
    vertical-align:top;
    letter-spacing:0;
}

.condition{
    font-size:19px;
    font-weight:700;
    margin-top:13px;
}

.feels{
    color:var(--muted);
    margin-top:5px;
    font-size:13px;
}

.weather-grid{
    margin-top:30px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.weather-stat{
    background:rgba(255,255,255,.035);
    border:1px solid rgba(255,255,255,.055);
    border-radius:15px;
    padding:13px;
}

.weather-stat-label{
    color:var(--muted);
    font-size:11px;
}

.weather-stat-value{
    font-size:15px;
    font-weight:800;
    margin-top:5px;
}

/* ================= FIRE STATUS ================= */

.fire-hero{
    padding:25px;
    position:relative;
    overflow:hidden;
}

.fire-label{
    color:#ff9494;
    font-size:12px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.5px;
}

.fire-big{
    display:flex;
    align-items:center;
    gap:17px;
    margin-top:17px;
}

.fire-icon{
    width:66px;
    height:66px;
    border-radius:20px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
    background:
    linear-gradient(145deg,
    rgba(255,32,45,.25),
    rgba(255,130,0,.1));
    border:1px solid rgba(255,60,40,.3);
}

.fire-count{
    font-size:46px;
    font-weight:900;
}

.fire-description{
    color:var(--muted);
    margin-top:2px;
    font-size:12px;
}

.fire-mini-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:22px;
}

.mini{
    padding:13px;
    background:rgba(255,255,255,.035);
    border-radius:14px;
}

.mini span{
    display:block;
    color:var(--muted);
    font-size:11px;
}

.mini strong{
    display:block;
    margin-top:5px;
}

/* ================= MAP ================= */

.map-card{
    padding:0;
    overflow:hidden;
    margin-bottom:18px;
}

.map-header{
    min-height:68px;
    padding:15px 17px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    border-bottom:1px solid var(--border);
}

.map-title{
    font-weight:800;
}

.map-subtitle{
    color:var(--muted);
    font-size:11px;
    margin-top:3px;
}

.map-controls{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
}

.map-btn{
    border:1px solid var(--border);
    color:#dce5ef;
    background:rgba(255,255,255,.045);
    border-radius:11px;
    padding:9px 12px;
    font-size:12px;
}

.map-btn.active{
    background:rgba(255,32,45,.15);
    border-color:rgba(255,32,45,.5);
    color:#fff;
}

#map{
    width:100%;
    height:620px;
    background:#08101b;
}

/* ================= FORECAST ================= */

.section-title{
    font-size:17px;
    font-weight:900;
    margin:24px 0 12px;
}

.hourly{
    display:flex;
    overflow-x:auto;
    gap:10px;
    padding-bottom:4px;
}

.hour{
    min-width:115px;
    padding:15px;
    text-align:center;
    border-radius:18px;
    background:var(--panel);
    border:1px solid var(--border);
}

.hour-time{
    color:var(--muted);
    font-size:11px;
}

.hour-icon{
    font-size:30px;
    margin:12px 0;
}

.hour-temp{
    font-size:19px;
    font-weight:800;
}

.hour-rain{
    color:#65b8ff;
    font-size:11px;
    margin-top:6px;
}

.daily{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:10px;
}

.day{
    padding:17px 12px;
    text-align:center;
    border-radius:18px;
    background:var(--panel);
    border:1px solid var(--border);
}

.day-name{
    font-weight:800;
    font-size:12px;
}

.day-icon{
    font-size:31px;
    margin:13px 0;
}

.day-temp{
    font-weight:900;
}

.day-low{
    color:var(--muted);
    font-size:12px;
    margin-top:4px;
}

.day-rain{
    color:#65b8ff;
    font-size:11px;
    margin-top:8px;
}

/* ================= LOWER GRID ================= */

.lower-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
    margin-top:18px;
}

.panel{
    padding:20px;
}

.panel-title{
    font-weight:900;
    margin-bottom:15px;
}

.info-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    padding:12px 0;
    border-bottom:1px solid rgba(255,255,255,.06);
    font-size:13px;
}

.info-row:last-child{
    border-bottom:0;
}

.info-label{
    color:var(--muted);
}

/* ================= EMERGENCY ================= */

.emergency{
    margin-top:18px;
    padding:18px;
    border-radius:20px;
    border:1px solid rgba(255,32,45,.2);
    background:
    linear-gradient(135deg,
    rgba(255,32,45,.09),
    rgba(255,255,255,.02));
}

.emergency-title{
    font-weight:900;
    margin-bottom:13px;
}

.emergency-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.emergency-btn{
    min-height:64px;
    border-radius:15px;
    border:1px solid rgba(255,255,255,.08);
    background:#111c2c;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
}

.emergency-number{
    color:#ff535b;
    font-size:25px;
    font-weight:900;
}

.emergency-label{
    color:var(--muted);
    font-size:11px;
}

/* ================= ALERT ================= */

.alert{
    margin-top:18px;
    padding:17px;
    border-radius:17px;
    background:rgba(255,168,0,.06);
    border:1px solid rgba(255,168,0,.18);
    color:#e6c982;
    font-size:12px;
    line-height:1.6;
}

/* ================= FOOTER ================= */

footer{
    max-width:1500px;
    margin:auto;
    padding:20px;
    color:#68778b;
    font-size:11px;
    text-align:center;
    line-height:1.7;
}

.source-links{
    margin-top:7px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.source-links a{
    color:#9fb0c4;
    text-decoration:underline;
}

/* ================= LOADING ================= */

.loading{
    color:var(--muted);
    font-size:12px;
}

.status{
    margin-top:8px;
    color:var(--muted);
    font-size:11px;
}

/* ================= LEAFLET ================= */

.leaflet-control-zoom a{
    background:#0b1422!important;
    color:#fff!important;
    border-color:#26364c!important;
}

.leaflet-control-attribution{
    background:rgba(5,11,20,.8)!important;
    color:#7e8da1!important;
}

.leaflet-control-attribution a{
    color:#aabbd0!important;
}

.fire-marker{
    width:18px;
    height:18px;
    border-radius:50%;
    background:#ff2b22;
    border:3px solid #fff;
    box-shadow:
    0 0 8px #ff0000,
    0 0 20px rgba(255,40,0,.9);
    animation:firePulse 1.3s infinite;
}

.fire-marker.high{
    background:#ff7800;
    box-shadow:
    0 0 8px #ff7800,
    0 0 25px rgba(255,120,0,.9);
}

@keyframes firePulse{
    50%{
        transform:scale(1.4);
        opacity:.75;
    }
}

/* ================= SETTINGS ================= */

.settings{
    margin-top:18px;
    padding:18px;
}

.settings summary{
    cursor:pointer;
    font-weight:800;
}

.settings-content{
    margin-top:15px;
    display:grid;
    grid-template-columns:1fr auto;
    gap:10px;
}

.settings input{
    height:46px;
    width:100%;
    border-radius:12px;
    border:1px solid var(--border);
    background:#070f1b;
    color:white;
    padding:0 13px;
}

.small-note{
    grid-column:1/-1;
    color:var(--muted);
    font-size:11px;
    line-height:1.6;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1000px){

    .hero{
        grid-template-columns:1fr;
    }

    .daily{
        grid-template-columns:repeat(4,1fr);
    }

}

@media(max-width:700px){

    .header-inner{
        padding:12px 14px;
    }

    .brand-title{
        font-size:14px;
    }

    .live{
        padding:6px 9px;
        font-size:10px;
    }

    .container{
        padding:15px 12px 35px;
    }

    .searchbar{
        grid-template-columns:1fr;
    }

    .temp{
        font-size:58px;
    }

    .weather-icon{
        font-size:56px;
    }

    .weather-main{
        padding:21px;
    }

    .weather-grid{
        grid-template-columns:1fr 1fr;
    }

    #map{
        height:470px;
    }

    .daily{
        grid-template-columns:1fr 1fr;
    }

    .lower-grid{
        grid-template-columns:1fr;
    }

    .settings-content{
        grid-template-columns:1fr;
    }

}

</style>
</head>

<body>

<header>
<div class="header-inner">

    <div class="brand">

        <div class="logo">🔥</div>

        <div>
            <div class="brand-title">
                INGENIOUS FIRE ALGERIA
            </div>

            <div class="brand-sub">
                WEATHER • FIRE • RADAR • SATELLITE
            </div>
        </div>

    </div>

    <div class="live">
        <span class="live-dot"></span>
        LIVE MONITORING
    </div>

</div>
</header>


<main class="container">


<!-- SEARCH -->

<div class="searchbar">

    <div class="search-wrap">

        <input
            id="searchInput"
            type="text"
            placeholder="Rechercher une ville en Algérie..."
            autocomplete="off"
        >

    </div>

    <button class="btn btn-blue" onclick="searchCity()">
        🔎 Rechercher
    </button>

    <button class="btn" onclick="useMyLocation()">
        📍 Ma position
    </button>

</div>


<!-- WEATHER + FIRE -->

<section class="hero">

    <div class="card weather-main">

        <div class="city" id="cityName">
            Alger, Algérie
        </div>

        <div class="date" id="dateText">
            Chargement...
        </div>

        <div class="temp-row">

            <div class="weather-icon" id="weatherIcon">
                🌤️
            </div>

            <div>

                <div class="temp">
                    <span id="temperature">--</span>
                    <span class="degree">°</span>
                </div>

                <div class="condition" id="condition">
                    Chargement météo...
                </div>

                <div class="feels">
                    Ressenti <span id="feels">--</span>°
                </div>

            </div>

        </div>


        <div class="weather-grid">

            <div class="weather-stat">
                <div class="weather-stat-label">HUMIDITÉ</div>
                <div class="weather-stat-value">
                    <span id="humidity">--</span>%
                </div>
            </div>

            <div class="weather-stat">
                <div class="weather-stat-label">VENT</div>
                <div class="weather-stat-value">
                    <span id="wind">--</span> km/h
                </div>
            </div>

            <div class="weather-stat">
                <div class="weather-stat-label">PRESSION</div>
                <div class="weather-stat-value">
                    <span id="pressure">--</span> hPa
                </div>
            </div>

            <div class="weather-stat">
                <div class="weather-stat-label">UV</div>
                <div class="weather-stat-value">
                    <span id="uv">--</span>
                </div>
            </div>

        </div>

    </div>


    <div class="card fire-hero">

        <div class="fire-label">
            🔥 FIRE DETECTION — ALGERIA
        </div>

        <div class="fire-big">

            <div class="fire-icon">
                🔥
            </div>

            <div>

                <div class="fire-count" id="fireCount">
                    --
                </div>

                <div class="fire-description">
                    satellite thermal anomalies
                </div>

            </div>

        </div>


        <div class="fire-mini-grid">

            <div class="mini">
                <span>HIGH / NOMINAL</span>
                <strong id="highFire">--</strong>
            </div>

            <div class="mini">
                <span>MAX FRP</span>
                <strong id="maxFrp">-- MW</strong>
            </div>

            <div class="mini">
                <span>LAST DETECTION</span>
                <strong id="lastFire">--</strong>
            </div>

            <div class="mini">
                <span>DATA</span>
                <strong>NASA FIRMS</strong>
            </div>

        </div>

        <div class="status" id="fireStatus">
            Waiting for NASA FIRMS...
        </div>

    </div>

</section>


<!-- MAP -->

<section class="card map-card">

    <div class="map-header">

        <div>
            <div class="map-title">
                🗺️ Algeria Live Monitoring Map
            </div>

            <div class="map-subtitle">
                Fire hotspots • Weather radar • Satellite
            </div>
        </div>


        <div class="map-controls">

            <button
                class="map-btn active"
                id="firesButton"
                onclick="toggleFires()">
                🔥 حرائق
            </button>

            <button
                class="map-btn"
                id="radarButton"
                onclick="toggleRadar()">
                🌧️ Radar
            </button>

            <button
                class="map-btn"
                onclick="resetAlgeria()">
                🇩🇿 الجزائر
            </button>

        </div>

    </div>


    <div id="map"></div>

</section>


<!-- HOURLY -->

<div class="section-title">
    ⏱️ Prévisions horaires
</div>

<div class="hourly" id="hourly">
    <div class="loading">
        Chargement...
    </div>
</div>


<!-- DAILY -->

<div class="section-title">
    📅 Prévisions 7 jours
</div>

<div class="daily" id="daily">
    <div class="loading">
        Chargement...
    </div>
</div>


<!-- LOWER -->

<div class="lower-grid">

    <div class="card panel">

        <div class="panel-title">
            🌬️ Conditions détaillées
        </div>

        <div class="info-row">
            <span class="info-label">Rafales</span>
            <strong>
                <span id="gusts">--</span> km/h
            </strong>
        </div>

        <div class="info-row">
            <span class="info-label">Direction du vent</span>
            <strong>
                <span id="windDirection">--</span>°
            </strong>
        </div>

        <div class="info-row">
            <span class="info-label">Précipitations</span>
            <strong>
                <span id="rain">--</span> mm
            </strong>
        </div>

        <div class="info-row">
            <span class="info-label">Visibilité météo</span>
            <strong>
                Données satellite
            </strong>
        </div>

    </div>


    <div class="card panel">

        <div class="panel-title">
            🛰️ État des données
        </div>

        <div class="info-row">
            <span class="info-label">Weather</span>
            <strong>Open-Meteo</strong>
        </div>

        <div class="info-row">
            <span class="info-label">Fire detection</span>
            <strong>NASA FIRMS</strong>
        </div>

        <div class="info-row">
            <span class="info-label">Radar</span>
            <strong>RainViewer</strong>
        </div>

        <div class="info-row">
            <span class="info-label">Map</span>
            <strong>OpenStreetMap</strong>
        </div>

    </div>

</div>


<!-- EMERGENCY -->

<div class="emergency">

    <div class="emergency-title">
        🚨 URGENCE EN ALGÉRIE
    </div>

    <div class="emergency-grid">

        <a
