    const now =
    new Date();


    let start =
    data.hourly.time.findIndex(
        t =>
        new Date(t) >= now
    );


    if(
        start < 0
    ){

        start=0;

    }


    for(
        let i=start;
        i<Math.min(
            start+12,
            data.hourly.time.length
        );
        i++
    ){

        const time =
        new Date(
            data.hourly.time[i]
        );


        const info =
        weatherInfo(
            data.hourly.weather_code[i]
        );


        const div =
        document.createElement(
            "div"
