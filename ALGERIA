        i===0
        ?
        "اليوم"
        :
        date.toLocaleDateString(
            "ar-DZ",
            {
                weekday:"short"
            }
        );


        const max =
        Math.round(
            data.daily.temperature_2m_max[i]
        );


        const min =
        Math.round(
            data.daily.temperature_2m_min[i]
        );


        const rain =
        data.daily.precipitation_probability_max[i]
        ||
        0;


        div.innerHTML = `

            <div class="dayName">
                ${name}
            </div>

            <div class="dayIcon">
                ${info[0]}
            </div>

            <div>

                <div
                class="dayBar"
                title="احتمال هطول ${rain}%">

                    <span
                    style="
                    width:${Math.max(
                        12,
                        rain
                    )}%;
                    ">
                    </span>

                </div>

                <div
                style="
                font-size:7px;
                color:#71869b;
                margin-top:4px;
                ">

                    مطر ${rain}%

                </div>

            </div>

            <div class="dayTemp">

                ${max}° / ${min}°

            </div>

        `;


        container.appendChild(
            div
        );

    }

}


/* =========================================================
   SEARCH ALGERIA
========================================================= */

async function searchAlgeria(){

    const query =
    document
    .getElementById(
        "locationSearch"
    )
    .value
    .trim();


    if(
        !query
    ){

        return;

    }


    try{

        const url =
        "https://nominatim.openstreetmap.org/search"
        +
        "?format=json"
        +
        "&limit=1"
        +
        "&countrycodes=dz"
        +
        "&q="
        +
        encodeURIComponent(
            query
        );


        const response =
        await fetch(
            url,
            {
                headers:{
                    "Accept":
                    "application/json"
                }
            }
        );


        const results =
        await response.json();


        if(
            !results.length
        ){

            alert(
                "لم يتم العثور على هذا المكان داخل الجزائر."
            );

            return;

        }


        currentLat =
        parseFloat(
            results[0].lat
        );


        currentLon =
        parseFloat(
            results[0].lon
        );


        currentCity =
        results[0].display_name
        .split(",")[0];


        document.getElementById(
            "cityName"
        ).textContent =
        currentCity;


        map.setView(
            [
                currentLat,
                currentLon
            ],
            9
        );


        loadWeather();


    }catch(error){

        alert(
            "تعذر تنفيذ البحث."
        );

    }

}


/* =========================================================
   ENTER SEARCH
========================================================= */

document
.getElementById(
    "locationSearch"
)
.addEventListener(
    "keydown",
    event => {

        if(
            event.key === "Enter"
        ){

            searchAlgeria();

        }

    }
);


/* =========================================================
   USER LOCATION
========================================================= */

function getMyLocation(){

    if(
        !navigator.geolocation
    ){

        alert(
            "المتصفح لا يدعم تحديد الموقع."
        );

        return;

    }


    navigator.geolocation.getCurrentPosition(

        position => {

            currentLat =
            position.coords.latitude;

            currentLon =
            position.coords.longitude;


            map.setView(
                [
                    currentLat,
                    currentLon
                ],
                10
            );


            L.marker(
                [
                    currentLat,
                    currentLon
                ]
            )
            .addTo(map)
            .bindPopup(
                "📍 موقعك الحالي"
            )
            .openPopup();


            loadWeather();

        },

        () => {

            alert(
                "لم يتم السماح بالوصول إلى موقعك."
            );

        },

        {
            enableHighAccuracy:true,

            timeout:10000,

            maximumAge:300000
        }

    );

}


/* =========================================================
   RESET MAP
========================================================= */

function resetMap(){

    map.fitBounds(
        ALGERIA_BOUNDS,
        {
            padding:
            [20,20]
        }
    );

}


/* =========================================================
   MAP CLICK
========================================================= */

map.on(
    "click",
    event => {

        const lat =
        event.latlng.lat
        .toFixed(5);


        const lon =
        event.latlng.lng
        .toFixed(5);


        L.popup()

        .setLatLng(
            event.latlng
        )

        .setContent(

            `

            <div
            style="
            direction:rtl;
            color:#111;
            ">

                <strong>
                    📍 موقع على خريطة الجزائر
                </strong>

                <br><br>

                Latitude:
                ${lat}

                <br>

                Longitude:
                ${lon}

                <br><br>

                <a
                target="_blank"
                href="
                https://www.google.com/maps/search/?api=1&query=${lat},${lon}
                ">

                    فتح في Google Maps

                </a>

            </div>

            `

        )

        .openOn(map);

    }
);


