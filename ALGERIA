}


/* =========================================================
   FIRE STATS
========================================================= */

function updateFireStats(
    fires
){

    const count =
    fires.length;


    let high =
    0;


    let maxFRP =
    0;


    fires.forEach(
        fire => {


            const confidence =
            String(
                fire.confidence ||
                ""
            ).toLowerCase();


            if(
                confidence ===
                "nominal"
                ||
                confidence ===
                "high"
            ){

                high++;

            }


            const frp =
            parseFloat(
                fire.frp
            );


            if(
                !isNaN(frp) &&
                frp > maxFRP
            ){

                maxFRP =
                frp;

            }

        }
    );


    document.getElementById(
        "fireCount"
    ).textContent =
    count;


    document.getElementById(
        "highConfidence"
    ).textContent =
    high;


    document.getElementById(
        "maxFRP"
    ).textContent =
    maxFRP
    ?
    maxFRP.toFixed(1)
    :
    "--";


    document.getElementById(
        "fireUpdated"
    ).textContent =
    new Date()
    .toLocaleTimeString(
        "ar-DZ",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


