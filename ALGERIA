/* =========================================================
   FIRE API
========================================================= */

async function loadFireData(){

    if(
        !NASA_MAP_KEY ||
        NASA_MAP_KEY ===
        "YOUR_NASA_FIRMS_MAP_KEY"
    ){

        document.getElementById(
            "fireStatus"
        ).textContent =
        "NASA MAP KEY غير موجود";

        return;

    }


    try{


        /*
          Algeria approximate bounding box:

          west,south,east,north
        */

        const bbox =
        "-8.7,18.9,11.9,37.3";


        const sources = [

            "VIIRS_NOAA20_NRT",

            "VIIRS_NOAA21_NRT",

            "VIIRS_SNPP_NRT"

        ];


        let allData = [];


        for(
            const source of sources
        ){

            const url =
            "https://firms.modaps.eosdis.nasa.gov/api/area/csv/"
            +
            NASA_MAP_KEY
            +
            "/"
            +
            source
            +
            "/"
            +
            bbox
            +
            "/1";


            const response =
            await fetch(
                url
            );


            if(
                !response.ok
            ){

                continue;

            }


            const csv =
            await response.text();


            const rows =
            parseCSV(csv);


            allData =
            allData.concat(
                rows
            );

        }


        /*
           Remove duplicate detections
        */

        const unique =
        new Map();


        allData.forEach(
            fire => {

                if(
                    !fire.latitude ||
                    !fire.longitude
                ){

                    return;

                }


                const key =
                    fire.latitude
                    +
                    "_"
                    +
                    fire.longitude
                    +
                    "_"
                    +
                    fire.acq_date
                    +
                    "_"
                    +
                    fire.acq_time;


                unique.set(
                    key,
                    fire
                );

            }
        );


        const fires =
        Array.from(
            unique.values()
        );


        showFireMarkers(
            fires
        );


        updateFireStats(
            fires
        );


        document.getElementById(
            "fireStatus"
        ).textContent =
        "NASA FIRMS • VIIRS • آخر 24 ساعة";


    }catch(error){

        console.error(
            error
        );


        document.getElementById(
            "fireStatus"
        ).textContent =
        "تعذر تحميل بيانات الحرائق";

    }

}


/* =========================================================
   CSV PARSER
========================================================= */

function parseCSV(text){

    const lines =
    text.trim().split(/\r?\n/);


    if(
        lines.length < 2
    ){

        return [];

    }


    const headers =
    lines[0].split(",");


    const result = [];


    for(
        let i=1;
        i<lines.length;
        i++
    ){

        const values =
        lines[i].split(",");


        const obj = {};


        headers.forEach(
            (header,index) => {

                obj[
                    header.trim()
                ] =
                (
                    values[index] || ""
                ).trim();

            }
        );


        result.push(
            obj
        );

    }


    return result;

}


