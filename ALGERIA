<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<meta name="theme-color"
      content="#07111f">

<title>
INGENIOUS FIRE ALGERIA | Algeria Weather & Fire Monitor
</title>

<meta name="description"
content="منصة جزائرية لمراقبة الطقس والبؤر الحرارية والأمطار والرياح عبر بيانات الأقمار الصناعية.">

<link rel="preconnect"
      href="https://unpkg.com">

<link rel="preconnect"
      href="https://tile.openstreetmap.org">

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">


<style>

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    min-height:100%;
    font-family:
        Arial,
        "Segoe UI",
        Tahoma,
        sans-serif;

    background:#07111f;
    color:#fff;
}

body{
    overflow-x:hidden;
}


/* =========================================================
   VARIABLES
========================================================= */

:root{

    --bg:#07111f;

    --panel:#0c1828;

    --panel2:#102238;

    --border:rgba(255,255,255,.09);

    --text:#ffffff;

    --muted:#91a1b4;

    --blue:#1683ff;

    --blue2:#39a8ff;

    --red:#ff3131;

    --orange:#ff8a00;

    --green:#2bd576;

    --yellow:#ffd43b;

}


/* =========================================================
   APP
========================================================= */

.app{
    min-height:100vh;

    background:
        radial-gradient(
            circle at 20% 0%,
            rgba(22,131,255,.16),
            transparent 35%
        ),

        radial-gradient(
            circle at 90% 20%,
            rgba(255,49,49,.08),
            transparent 30%
        ),

        var(--bg);
}


/* =========================================================
   HEADER
========================================================= */

.header{

    height:72px;

    position:sticky;

    top:0;

    z-index:5000;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:
        0 25px;

    background:
        rgba(5,13,24,.93);

    backdrop-filter:
        blur(20px);

    border-bottom:
        1px solid var(--border);
}


.brand{

    display:flex;

    align-items:center;

    gap:12px;
}


.brandLogo{

    width:43px;

    height:43px;

    border-radius:12px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:24px;

    background:
        linear-gradient(
            145deg,
            #ff3b30,
            #c40000
        );

    box-shadow:
        0 0 25px
        rgba(255,49,49,.25);
}


.brandText{

    display:flex;

    flex-direction:column;

}


.brandText strong{

    font-size:17px;

    letter-spacing:.7px;
}


.brandText span{

    font-size:9px;

    color:var(--muted);

    margin-top:3px;

}


.headerRight{

    display:flex;

    align-items:center;

    gap:9px;

}


.liveBadge{

    display:flex;

    align-items:center;

    gap:6px;

    padding:
        7px 10px;

    border:
        1px solid
        rgba(43,213,118,.2);

    border-radius:20px;

    background:
        rgba(43,213,118,.07);

    font-size:9px;

    color:#b8ffd5;
}


.liveDot{

    width:7px;

    height:7px;

    border-radius:50%;

    background:#2bd576;

    box-shadow:
        0 0 10px
        #2bd576;

    animation:
        livePulse 1.5s infinite;
}


@keyframes livePulse{

    50%{
        opacity:.35;
    }

}


/* =========================================================
   MAIN
========================================================= */

.main{

    max-width:1550px;

    margin:auto;

    padding:
        18px;
}


/* =========================================================
   SEARCH
========================================================= */

.searchRow{

    display:flex;

    gap:10px;

    margin-bottom:15px;
}


.searchBox{

    flex:1;

    display:flex;

    align-items:center;

    gap:8px;

    background:
        var(--panel);

    border:
        1px solid
        var(--border);

    border-radius:13px;

    padding:
        4px 7px;
}


.searchBox input{

    flex:1;

    min-width:0;

    border:0;

    outline:0;

    background:transparent;

    color:#fff;

    padding:11px;

    font-size:12px;
}


.searchBox input::placeholder{

    color:#6e8095;

}


.btn{

    border:0;

    cursor:pointer;

    border-radius:10px;

    padding:
        10px 14px;

    color:#fff;

    background:
        #17283c;

    border:
        1px solid
        var(--border);

    transition:.2s;

    font-weight:600;

    font-size:11px;
}


.btn:hover{

    background:#20364f;

}


.btnBlue{

    background:
        linear-gradient(
            135deg,
            #0875ee,
            #179cff
        );

    border-color:
        transparent;
}


.btnRed{

    background:
        linear-gradient(
            135deg,
            #d91515,
            #ff3c3c
        );

    border-color:
        transparent;
}


/* =========================================================
   WEATHER HERO
========================================================= */

.weatherHero{

    position:relative;

    overflow:hidden;

    min-height:245px;

    border-radius:22px;

    padding:25px;

    margin-bottom:15px;

    background:

        linear-gradient(
            115deg,
            rgba(15,66,112,.95),
            rgba(11,28,48,.97)
        );

    border:
        1px solid
        rgba(255,255,255,.1);

    box-shadow:
        0 15px 60px
        rgba(0,0,0,.25);
}


.weatherHero:before{

    content:"";

    position:absolute;

    width:430px;

    height:430px;

    left:-160px;

    top:-200px;

    border-radius:50%;

    background:
        rgba(38,156,255,.13);

    filter:
        blur(20px);
}


.weatherTop{

    position:relative;

    z-index:2;

    display:flex;

    align-items:flex-start;

    justify-content:space-between;
}


.location{

    display:flex;

    flex-direction:column;

    gap:5px;
}


.location h1{

    font-size:28px;

    font-weight:700;
}


.location span{

    font-size:11px;

    color:#a8bfd5;
}


.currentWeather{

    position:relative;

    z-index:2;

    display:flex;

    align-items:center;

    gap:20px;

    margin-top:28px;
}


.weatherIcon{

    font-size:72px;

    line-height:1;
}


.temperature{

    font-size:67px;

    line-height:.9;

    font-weight:300;
}


.temperature small{

    font-size:28px;

    vertical-align:top;

    color:#9eb6cc;
}


.condition{

    margin-top:8px;

    color:#d7e8f7;

    font-size:14px;
}


.feels{

    margin-top:5px;

    color:#8fa8be;

    font-size:10px;
}


/* =========================================================
   WEATHER METRICS
========================================================= */

.metrics{

    position:relative;

    z-index:2;

    display:grid;

    grid-template-columns:
        repeat(5,1fr);

    gap:8px;

    margin-top:20px;
}


.metric{

    padding:10px;

    border-radius:11px;

    background:
        rgba(255,255,255,.055);

    border:
        1px solid
        rgba(255,255,255,.07);
}


.metric span{

    display:block;

    color:#8da4ba;

    font-size:9px;

    margin-bottom:4px;
}


.metric strong{

    font-size:12px;
}


/* =========================================================
   DASH GRID
========================================================= */

.grid{

    display:grid;

    grid-template-columns:
        minmax(0,1.45fr)
        minmax(300px,.55fr);

    gap:15px;
}


/* =========================================================
   CARD
========================================================= */

.card{

    background:
        rgba(12,24,40,.9);

    border:
        1px solid
        var(--border);

    border-radius:18px;

    padding:17px;

    box-shadow:
        0 12px 40px
        rgba(0,0,0,.16);
}


.cardHeader{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:13px;
}


.cardTitle{

    display:flex;

    align-items:center;

    gap:8px;

    font-size:13px;

    font-weight:700;
}


.cardTitleIcon{

    width:28px;

    height:28px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:8px;

    background:
        rgba(22,131,255,.12);
}


/* =========================================================
   FORECAST
========================================================= */

.hourly{

    display:flex;

    gap:8px;

    overflow-x:auto;

    padding-bottom:3px;
}


.hourly::-webkit-scrollbar{

    height:3px;

}


.hourly::-webkit-scrollbar-thumb{

    background:#31445b;

    border-radius:10px;

}


.hour{

    min-width:72px;

    padding:10px 7px;

    text-align:center;

    border-radius:11px;

    background:
        #0a1727;

    border:
        1px solid
        rgba(255,255,255,.06);
}


.hourTime{

    color:#8295aa;

    font-size:9px;

    margin-bottom:7px;
}


.hourIcon{

    font-size:24px;

    margin-bottom:5px;
}


.hourTemp{

    font-size:12px;

    font-weight:bold;

}


.hourRain{

    margin-top:5px;

    font-size:8px;

    color:#5db9ff;
}


/* =========================================================
   DAILY
========================================================= */

.daily{

    display:flex;

    flex-direction:column;

    gap:5px;
}


.day{

    display:grid;

    grid-template-columns:
        70px
        45px
        1fr
        80px;

    align-items:center;

    padding:10px;

    border-radius:10px;

    background:
        rgba(255,255,255,.025);
}


.dayName{

    font-size:10px;

    color:#a7b8c9;
}


.dayIcon{

    font-size:22px;
}


.dayBar{

    height:5px;

    border-radius:10px;

    background:#1a2b3e;

    overflow:hidden;

}


.dayBar span{

    display:block;

    height:100%;

    width:65%;

    border-radius:10px;

    background:
        linear-gradient(
            90deg,
            #1592ff,
            #ffbd35
        );
}


.dayTemp{

    text-align:left;

    font-size:10px;
}


/* =========================================================
   MAP
========================================================= */

.mapCard{

    grid-column:
        1 / -1;

    padding:0;

    overflow:hidden;

}


.mapHeader{

    padding:
        16px 17px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;
}


.mapControls{

    display:flex;

    gap:6px;

    flex-wrap:wrap;
}


.mapButton{

    cursor:pointer;

    border:
        1px solid
        rgba(255,255,255,.08);

    background:#122238;

    color:#bcd0e2;

    padding:
        8px 10px;

    border-radius:8px;

    font-size:9px;
}


.mapButton.active{

    background:
        rgba(255,49,49,.16);

    color:#fff;

    border-color:
        rgba(255,49,49,.35);
}


#map{

    height:600px;

    width:100%;

    background:#07111f;
}


.leaflet-control-zoom a{

    background:#102238 !important;

    color:#fff !important;

    border-color:#26384c !important;
}


.leaflet-control-attribution{

    background:
        rgba(4,10,17,.8) !important;

    color:#71869b !important;

    font-size:8px !important;
}


.leaflet-control-attribution a{

    color:#8db9e8 !important;
}


/* =========================================================
   FIRE MARKER
========================================================= */

.fireMarker{

    width:19px;

    height:19px;

    border-radius:50%;

    background:#ff1515;

    border:2px solid #fff;

    box-shadow:
        0 0 0 6px
        rgba(255,30,30,.15),

        0 0 20px
        rgba(255,0,0,.95);

    animation:
        firePulse 1.4s infinite;
}


@keyframes firePulse{

    0%{
        transform:scale(.75);
        opacity:.7;
    }

    50%{
        transform:scale(1.1);
        opacity:1;
    }

    100%{
        transform:scale(.75);
        opacity:.7;
    }

}


/* =========================================================
   FIRE STATS
========================================================= */

.fireStats{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:8px;
}


.fireStat{

    padding:13px;

    border-radius:11px;

    background:
        #0a1727;

    border:
        1px solid
        rgba(255,255,255,.06);
}


.fireStat span{

    display:block;

    color:#8195aa;

    font-size:9px;

    margin-bottom:5px;
}


.fireStat strong{

    font-size:18px;
}


/* =========================================================
   WEATHER RADAR
========================================================= */

.radarInfo{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:10px;

    font-size:9px;

    color:#8095aa;
}


.radarStatus{

    color:#5db9ff;
}


/* =========================================================
   ALERTS
========================================================= */

.alerts{

    display:flex;

    flex-direction:column;

    gap:8px;
}


.alert{

    display:flex;

    gap:10px;

    padding:11px;

    border-radius:11px;

    background:
        #0a1727;

    border:
        1px solid
        rgba(255,255,255,.06);
}


.alertIcon{

    width:30px;

    height:30px;

    flex-shrink:0;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:9px;

    background:
        rgba(255,49,49,.12);
}


.alertText strong{

    display:block;

    font-size:10px;

    margin-bottom:3px;
}


.alertText span{

    color:#8295aa;

    font-size:8px;

    line-height:1.6;
}


/* =========================================================
   EMERGENCY
========================================================= */

.emergency{

    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:8px;
}


.emergency a{

    text-decoration:none;

    text-align:center;

    padding:13px;

    border-radius:11px;

    background:
        #121e2d;

    border:
        1px solid
        rgba(255,255,255,.08);

    color:#fff;
}


.emergency a:hover{

    border-color:
        rgba(255,49,49,.4);

}


.emergency strong{

    display:block;

    color:#ff3e3e;

    font-size:20px;
}


.emergency span{

    display:block;

    color:#8195aa;

    font-size:8px;

    margin-top:3px;
}


/* =========================================================
   SOURCES
========================================================= */

.sources{

    display:flex;

    flex-wrap:wrap;

    gap:6px;
}


.source{

    padding:
        7px 9px;

    border-radius:8px;

    background:
        rgba(255,255,255,.035);

    color:#91a5b8;

    font-size:8px;
}


/* =========================================================
   FOOTER
========================================================= */

.footer{

    margin-top:15px;

    padding:20px;

    text-align:center;

    color:#667a90;

    font-size:8px;

    line-height:1.8;

}


/* =========================================================
   LOADING
========================================================= */

.loading{

    color:#71859a;

    font-size:10px;

    padding:12px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){

    .grid{

        grid-template-columns:1fr;

    }

}


@media(max-width:700px){

    .header{

        height:62px;

        padding:
            0 12px;

    }


    .brandLogo{

        width:37px;

        height:37px;

        font-size:20px;

    }


    .brandText strong{

        font-size:13px;

    }


    .brandText span{

        display:none;

    }


    .liveBadge{

        font-size:7px;

    }


    .main{

        padding:10px;

    }


    .searchRow{

        flex-direction:column;

    }


    .weatherHero{

        min-height:260px;

        padding:18px;

        border-radius:17px;

    }


    .location h1{

        font-size:21px;

    }


    .currentWeather{

        margin-top:25px;

    }


    .weatherIcon{

        font-size:55px;

    }


    .temperature{

        font-size:54px;

    }


    .metrics{

        grid-template-columns:
            repeat(2,1fr);

    }


    .metric:last-child{

        grid-column:
            1 / -1;

    }


    .fireStats{

        grid-template-columns:
            repeat(2,1fr);

    }


    .day{

        grid-template-columns:
            58px
            35px
            1fr
            65px;

    }


    #map{

        height:480px;

    }


    .mapHeader{

        align-items:flex-start;

        flex-direction:column;

    }


    .mapControls{

        width:100%;

    }


    .mapButton{

        flex:1;

    }

}

</style>

</head>


<body>

<div class="app">


<!-- =======================================================
     HEADER
======================================================= -->

<header class="header">

    <div class="brand">

        <div class="brandLogo">
            🔥
        </div>

        <div class="brandText">

            <strong>
                INGENIOUS FIRE ALGERIA
            </strong>

            <span>
                WEATHER • FIRE • RADAR • SATELLITE
            </span>

        </div>

    </div>


    <div class="headerRight">

        <div class="liveBadge">

            <span class="liveDot"></span>

            مراقبة مباشرة

        </div>

    </div>

</header>


<main class="main">


<!-- =======================================================
     SEARCH
======================================================= -->

<div class="searchRow">

    <div class="searchBox">

        🔎

        <input
            id="locationSearch"
            placeholder="ابحث عن ولاية أو مدينة في الجزائر...">

        <button
            class="btn btnBlue"
            onclick="searchAlgeria()">

            بحث

        </button>

    </div>


    <button
        class="btn"
        onclick="getMyLocation()">

        📍 موقعي

    </button>

</div>


<!-- =======================================================
     WEATHER HERO
======================================================= -->

<section class="weatherHero">


    <div class="weatherTop">

        <div class="location">

            <h1 id="cityName">
                الجزائر
            </h1>

            <span id="dateText">
                جاري تحميل بيانات الطقس...
            </span>

        </div>


        <button
            class="btn"
            onclick="loadWeather()">

            ↻ تحديث

        </button>

    </div>


    <div class="currentWeather">

        <div
            class="weatherIcon"
            id="weatherIcon">

            ☀️

        </div>


        <div>

            <div
                class="temperature"
                id="temperature">

                --

                <small>°C</small>

            </div>


            <div
                class="condition"
                id="condition">

                جاري تحميل الطقس...

            </div>


            <div
                class="feels"
                id="feels">

                --

            </div>

        </div>

    </div>


    <div class="metrics">


        <div class="metric">

            <span>
                💧 الرطوبة
            </span>

            <strong id="humidity">
                --
            </strong>

        </div>


        <div class="metric">

            <span>
                💨 الرياح
            </span>

            <strong id="wind">
                --
            </strong>

        </div>


        <div class="metric">

            <span>
                🌬️ الهبات
            </span>

            <strong id="gust">
                --
            </strong>

        </div>


        <div class="metric">

            <span>
                🌡️ الضغط
            </span>

            <strong id="pressure">
                --
            </strong>

        </div>


        <div class="metric">

            <span>
                ☀️ مؤشر UV
            </span>

            <strong id="uv">
                --
            </strong>

        </div>

    </div>

</section>


<!-- =======================================================
     DASHBOARD
======================================================= -->

<div class="grid">


<!-- =======================================================
     HOURLY
======================================================= -->

<section class="card">

    <div class="cardHeader">

        <div class="cardTitle">

            <div class="cardTitleIcon">
                ⏱️
            </div>

            توقعات الساعات القادمة

        </div>

        <span
            style="
            font-size:8px;
            color:#71869b;
            ">

            Open-Meteo

        </span>

    </div>


    <div
        class="hourly"
        id="hourly">

        <div class="loading">
            جاري تحميل التوقعات...
        </div>

    </div>

</section>


<!-- =======================================================
     DAILY
======================================================= -->

<section class="card">

    <div class="cardHeader">

        <div class="cardTitle">

            <div class="cardTitleIcon">
                📅
            </div>

            توقعات الأيام

        </div>

    </div>


    <div
        class="daily"
        id="daily">

        <div class="loading">
            جاري التحميل...
        </div>

    </div>

</section>


<!-- =======================================================
     FIRE MAP
======================================================= -->

<section class="card mapCard">


    <div class="mapHeader">

        <div class="cardTitle">

            <div
                class="cardTitleIcon"
                style="
                background:
                rgba(255,49,49,.12);
                ">

                🔥

            </div>

            رصد الحرائق والبؤر الحرارية في الجزائر

        </div>


        <div class="mapControls">


            <button
                id="fireBtn"
                class="mapButton active"
                onclick="toggleFires()">

                🔥 الحرائق

            </button>


            <button
                id="radarBtn"
                class="mapButton"
                onclick="toggleRadar()">

                🌧️ الرادار

            </button>


            <button
                class="mapButton"
                onclick="resetMap()">

                🇩🇿 الجزائر

            </button>

        </div>

    </div>


    <div id="map"></div>


</section>


<!-- =======================================================
     FIRE STATS
======================================================= -->

<section class="card">


    <div class="cardHeader">

        <div class="cardTitle">

            <div
                class="cardTitleIcon"
                style="
                background:
                rgba(255,49,49,.12);
                ">

                🔥

            </div>

            حالة الرصد الحراري

        </div>


        <span
            id="fireStatus"
            style="
            font-size:8px;
            color:#71869b;
            ">

            جاري الاتصال...

