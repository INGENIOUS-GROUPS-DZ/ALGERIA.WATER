<script>

/* ============================================================
   INGENIOUS FIRE ALGERIA
   COMPLETE SINGLE-FILE APPLICATION
============================================================ */


/* ================= CONFIGURATION ================= */

const ALGERIA_BOUNDS = [
    [18.85, -8.75],
    [37.30, 11.95]
];

const DEFAULT_LOCATION = {
    lat:36.7525,
    lon:3.0420,
    name:"Alger, Algérie"
};


/*
   NASA FIRMS
   Add your key in the Settings section.
*/

let NASA_MAP_KEY =
    localStorage.getItem("ingenious_nasa_key") || "";


/* ================= MAP ================= */

const map = L.map("map",{
    zoomControl:true,
    minZoom:5,
    maxZoom:12,
    maxBounds:ALGERIA_BOUNDS,
    maxBoundsViscosity:1
});


/* DARK BASE MAP */

const darkMap = L.tileLayer(
    "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
    {
        maxZoom:19,
        attribution:
        '&copy; OpenStreetMap &copy; CARTO'
    }
).addTo(map);


/* Satellite-style base */

const satelliteMap = L.tileLayer(
    "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
    {
        maxZoom:19,
        attribution:
        "Tiles &copy; Esri"
    }
);


/* Start centered on Algeria */

map.fitBounds(ALGERIA_BOUNDS);


/* ================= LAYERS ================= */

let fireMarkersLayer =
    L.layerGroup().addTo(map);

let radarLayer = null;

let fireVisible = true;
let radarVisible = false;


/* ================= USER LOCATION ================= */

let currentLat =
    DEFAULT_LOCATION.lat;

let currentLon =
    DEFAULT_LOCATION.lon;

let currentCity =
    DEFAULT_LOCATION.name;


/* ================= WEATHER CODE ================= */

function weatherDescription(code){

    const data = {

        0:["☀️","Ciel dégagé"],
        1:["🌤️","Principalement dégagé"],
        2:["⛅","Partiellement nuageux"],
        3:["☁️","Couvert"],

        45:["🌫️","Brouillard"],
        48:["🌫️","Brouillard givrant"],

        51:["🌦️","Bruine légère"],
        53:["🌦️","Bruine"],
        55:["🌧️","Bruine forte"],

        61:["🌦️","Pluie légère"],
        63:["🌧️","Pluie"],
        65:["🌧️","Forte pluie"],

        71:["🌨️","Neige légère"],
        73:["🌨️","Neige"],
        75:["❄️","Forte neige"],

        80:["🌦️","Averses légères"],
        81:["🌧️","Averses"],
        82:["⛈️","Fortes averses"],

        95:["⛈️","Orage"],
        96:["⛈️","Orage avec grêle"],
        99:["⛈️","Orage fort avec grêle"]

    };

    return data[code] || ["🌤️","Conditions variables"];
}


/* ================= DATE ================= */

function formatDate(date){

    return new Intl.DateTimeFormat(
        "fr-FR",
        {
            weekday:"long",
            day:"numeric",
            month:"long",
            year:"numeric"
        }
    ).format(date);

}


/* ================= WEATHER ================= */

async function loadWeather(
    lat=currentLat,
    lon=currentLon,
    name=currentCity
){

    currentLat = lat;
    currentLon = lon;
    currentCity = name;


    document.getElementById("cityName")
        .textContent = name;


    document.getElementById("dateText")
        .textContent = formatDate(new Date());


    try{

        const url =
        "https://api.open-meteo.com/v1/forecast" +
        "?latitude=" + encodeURIComponent(lat) +
        "&longitude=" + encodeURIComponent(lon) +
        "&current=" +
        [
            "temperature_2m",
            "relative_humidity_2m",
            "apparent_temperature",
            "is_day",
            "precipitation",
            "rain",
            "weather_code",
            "surface_pressure",
            "wind_speed_10m",
            "wind_direction_10m",
            "wind_gusts_10m"
        ].join(",") +
        "&hourly=" +
        [
            "temperature_2m",
            "weather_code",
            "precipitation_probability",
            "precipitation"
        ].join(",") +
        "&daily=" +
        [
            "weather_code",
            "temperature_2m_max",
            "temperature_2m_min",
            "precipitation_probability_max"
        ].join(",") +
        "&forecast_days=7" +
        "&timezone=auto";


        const response =
            await fetch(url);

        if(!response.ok)
            throw new Error("Weather API error");


        const data =
            await response.json();


        updateCurrentWeather(data);
        updateHourly(data);
        updateDaily(data);


    }catch(error){

        console.error(error);

        document.getElementById("condition")
            .textContent =
            "Météo indisponible";

    }

}


/* ================= CURRENT WEATHER ================= */

function updateCurrentWeather(data){

    const c = data.current;

    const info =
        weatherDescription(c.weather_code);


    document.getElementById("weatherIcon")
        .textContent = info[0];

    document.getElementById("condition")
        .textContent = info[1];

    document.getElementById("temperature")
        .textContent =
        Math.round(c.temperature_2m);

    document.getElementById("feels")
        .textContent =
        Math.round(c.apparent_temperature);

    document.getElementById("humidity")
        .textContent =
        Math.round(c.relative_humidity_2m);

    document.getElementById("wind")
        .textContent =
        Math.round(c.wind_speed_10m);

    document.getElementById("pressure")
        .textContent =
        Math.round(c.surface_pressure);

    document.getElementById("gusts")
        .textContent =
        Math.round(c.wind_gusts_10m || 0);

    document.getElementById("windDirection")
        .textContent =
        Math.round(c.wind_direction_10m || 0);

    document.getElementById("rain")
        .textContent =
        (c.precipitation || 0).toFixed(1);


    /*
       UV is taken from daily if available.
    */

    if(data.daily &&
       data.daily.uv_index_max){

        document.getElementById("uv")
            .textContent =
            data.daily.uv_index_max[0] ??
            "--";

    }else{

        document.getElementById("uv")
            .textContent="--";

    }

}


/* ================= HOURLY ================= */

function updateHourly(data){

    const h = data.hourly;

    const container =
        document.getElementById("hourly");

    container.innerHTML="";


    const nowIndex =
        Math.max(
            0,
            h.time.findIndex(
                t => t >= new Date().toISOString().slice(0,13)
            )
        );


    const start =
        nowIndex >= 0 ? nowIndex : 0;


    for(
        let i=start;
        i<Math.min(start+24,h.time.length);
        i++
    ){

        const time =
            new Date(h.time[i]);


        const info =
            weatherDescription(
                h.weather_code[i]
            );


        const div =
            document.createElement("div");

        div.className="hour";


        const hour =
            time.toLocaleTimeString(
                "fr-FR",
                {
                    hour:"2-digit",
                    minute:"2-digit"
                }
            );


        div.innerHTML=`

            <div class="hour-time">
                ${hour}
            </div>

            <div class="hour-icon">
                ${info[0]}
            </div>

            <div class="hour-temp">
                ${Math.round(h.temperature_2m[i])}°
            </div>

            <div class="hour-rain">
                💧 ${h.precipitation_probability[i] ?? 0}%
            </div>

        `;


        container.appendChild(div);

    }

}


/* ================= DAILY ================= */

function updateDaily(data){

    const d = data.daily;

    const container =
        document.getElementById("daily");

    container.innerHTML="";


    for(let i=0;i<7;i++){

        const date =
            new Date(d.time[i]);


        const name =
            new Intl.DateTimeFormat(
                "fr-FR",
                {
                    weekday:"short"
                }
            ).format(date);


        const info =
            weatherDescription(
                d.weather_code[i]
            );


        const div =
            document.createElement("div");

        div.className="day";


        div.innerHTML=`

            <div class="day-name">
                ${name}
            </div>

            <div class="day-icon">
                ${info[0]}
            </div>

            <div class="day-temp">
                ${Math.round(d.temperature_2m_max[i])}°
            </div>

            <div class="day-low">
                ${Math.round(d.temperature_2m_min[i])}°
            </div>

            <div class="day-rain">
                💧 ${d.precipitation_probability_max[i] ?? 0}%
            </div>

        `;


        container.appendChild(div);

    }

}


/* ================= NASA FIRE API ================= */

async function loadFireData(){

    if(!NASA_MAP_KEY){

        document.getElementById("fireStatus")
            .textContent =
            "Ajoutez votre NASA FIRMS MAP_KEY dans ⚙️ Configuration.";

        document.getElementById("fireCount")
            .textContent="--";

        return;

    }


    document.getElementById("fireStatus")
        .textContent =
        "Connexion NASA FIRMS...";


    const bbox =
        "-8.75,18.85,11.95,37.30";


    const sources = [

        "VIIRS_NOAA20_NRT",
        "VIIRS_NOAA21_NRT"

    ];


    let all=[];


    for(const source of sources){

        try{

            const url =
            "https://firms.modaps.eosdis.nasa.gov/api/area/csv/" +
            encodeURIComponent(NASA_MAP_KEY) +
            "/" +
            source +
            "/" +
            bbox +
            "/1";


            const response =
                await fetch(url);


            if(!response.ok)
                continue;


            const text =
                await response.text();


            const rows =
                parseCSV(text);


            all =
                all.concat(rows);


        }catch(error){

            console.error(
                "NASA FIRMS error:",
                error
            );

        }

    }


    processFireData(all);

}


/* ================= CSV PARSER ================= */

function parseCSV(text){

    const lines =
        text
        .trim()
        .split(/\r?\n/);


    if(lines.length < 2)
        return [];


    const headers =
        lines[0]
        .split(",")
        .map(x=>x.trim());


    const result=[];


    for(let i=1;i<lines.length;i++){

        const values =
            lines[i].split(",");


        if(values.length !== headers.length)
            continue;


        const obj={};


        headers.forEach(
            (header,index)=>{
                obj[header] =
                    values[index]
                    ?.trim();
            }
        );


        result.push(obj);

    }


    return result;

}


/* ================= FIRE PROCESSING ================= */

function processFireData(data){

    fireMarkersLayer.clearLayers();


    if(!data.length){

        document.getElementById("fireCount")
            .textContent="0";

        document.getElementById("highFire")
            .textContent="0";

        document.getElementById("maxFrp")
            .textContent="0 MW";

        document.getElementById("fireStatus")
            .textContent =
            "Aucune détection retournée.";

        return;

    }


    let high=0;
    let maxFrp=0;
    let latest="--";


    data.forEach(fire=>{

        const lat =
            parseFloat(fire.latitude);

        const lon =
            parseFloat(fire.longitude);

        const frp =
            parseFloat(fire.frp) || 0;


        if(!Number.isFinite(lat) ||
           !Number.isFinite(lon))
            return;


        if(frp > maxFrp)
            maxFrp=frp;


        /*
           Confidence can appear as
           numeric or letter.
        */

        const confidence =
            String(
                fire.confidence || ""
            ).toLowerCase();


        if(
            confidence === "h" ||
            confidence === "high" ||
            Number(confidence) >= 80
        ){
            high++;
        }


        if(
            fire.acq_date
        ){

            latest =
                fire.acq_date +
                " " +
                (fire.acq_time || "");

        }


        addFireMarker(
            lat,
            lon,
            fire
        );

    });


    document.getElementById("fireCount")
        .textContent=data.length.toLocaleString();


    document.getElementById("highFire")
        .textContent=high.toLocaleString();


    document.getElementById("maxFrp")
        .textContent=
        Math.round(maxFrp) +
        " MW";


    document.getElementById("lastFire")
        .textContent=latest;


    document.getElementById("fireStatus")
        .textContent=
        "NASA FIRMS • VIIRS NOAA-20 / NOAA-21";

}


/* ================= FIRE MARKER ================= */

function addFireMarker(
    lat,
    lon,
    fire
){

    const frp =
        parseFloat(fire.frp) || 0;


    const confidence =
        String(
            fire.confidence || ""
        ).toLowerCase();


    const high =
        confidence==="h" ||
        confidence==="high" ||
        Number(confidence)>=80;


    const html =
        `<div class="fire-marker ${high ? "high":""}"></div>`;


    const icon =
        L.divIcon({

            html:html,

            className:"",

            iconSize:[18,18],

            iconAnchor:[9,9]

        });


    const marker =
        L.marker(
            [lat,lon],
            {
                icon:icon
            }
        );


    marker.bindPopup(`

        <div style="
            min-width:210px;
            color:#111;
            font-family:Arial;
        ">

            <strong style="
                font-size:16px;
            ">
                🔥 Satellite Hotspot
            </strong>

            <hr>

            <b>Latitude:</b>
            ${lat.toFixed(4)}
            <br>

            <b>Longitude:</b>
            ${lon.toFixed(4)}
            <br>

            <b>FRP:</b>
            ${frp.toFixed(1)} MW
            <br>

            <b>Confidence:</b>
            ${fire.confidence || "N/A"}
            <br>

            <b>Date:</b>
            ${fire.acq_date || "N/A"}
            <br>

            <b>Time:</b>
            ${fire.acq_time || "N/A"}
            <br>

            <b>Satellite:</b>
            ${fire.satellite || "VIIRS"}

        </div>

    `);


    fireMarkersLayer.addLayer(marker);

}


/* ================= TOGGLE FIRES ================= */

function toggleFires(){

    const button =
        document.getElementById("firesButton");


    if(fireVisible){

        map.removeLayer(
            fireMarkersLayer
        );

        fireVisible=false;

        button.classList.remove("active");

    }else{

        map.addLayer(
            fireMarkersLayer
        );

        fireVisible=true;

        button.classList.add("active");

    }

}


/* ================= RAINVIEWER ================= */

async function loadRadar(){

    try{

        const response =
            await fetch(
                "https://api.rainviewer.com/public/weather-maps.json"
            );


        if(!response.ok)
            throw new Error("Radar API error");


        const data =
            await response.json();


        if(
            !data.radar ||
            !data.radar.past ||
            !data.radar.past.length
        ){

            console.log(
                "No radar data available."
            );

            return;

        }


        const frame =
            data.radar.past[
                data.radar.past.length-1
            ];


        const url =
            data.host +
            frame.path +
            "/256/{z}/{x}/{y}/2/1_1.png";


        if(radarLayer){

            map.removeLayer(
                radarLayer
            );

        }


        radarLayer =
            L.tileLayer(
                url,
                {
                    opacity:.60,
                    maxZoom:7,
                    attribution:
                    'Weather data by <a href="https://www.rainviewer.com/" target="_blank">RainViewer</a>'
                }
            );


    }catch(error){

        console.error(
            "Radar error:",
            error
        );

    }

}


/* ================= TOGGLE RADAR ================= */

async function toggleRadar(){

    const button =
        document.getElementById("radarButton");


    if(!radarLayer)
        await loadRadar();


    if(!radarLayer)
        return;


    if(radarVisible){

        map.removeLayer(
            radarLayer
        );

        radarVisible=false;

        button.classList.remove(
            "active"
        );

    }else{

        radarLayer.addTo(map);

        radarVisible=true;

        button.classList.add(
            "active"
        );

    }

}


/* ================= SEARCH ================= */

async function searchCity(){

    const input =
        document.getElementById(
            "searchInput"
        );


    const query =
        input.value.trim();


    if(!query)
        return;


    try{

        const url =
        "https://nominatim.openstreetmap.org/search" +
        "?format=json" +
        "&limit=5" +
        "&countrycodes=dz" +
        "&q=" +
        encodeURIComponent(query);


        const response =
            await fetch(
                url,
                {
                    headers:{
                        "Accept-Language":"fr"
                    }
                }
            );


        const data =
            await response.json();


        if(!data.length){

            alert(
                "Ville introuvable en Algérie."
            );

            return;

        }


        const result =
            data[0];


        const lat =
            parseFloat(result.lat);

        const lon =
            parseFloat(result.lon);


        const name =
            result.display_name;


        if(
            lat < 18.85 ||
            lat > 37.30 ||
            lon < -8.75 ||
            lon > 11.95
        ){

            alert(
                "La recherche doit rester en Algérie."
            );

            return;

        }


        loadWeather(
            lat,
            lon,
            name
        );


        map.setView(
            [lat,lon],
            9
        );


        L.popup()
            .setLatLng([lat,lon])
            .setContent(
                "<strong>📍 " +
                name +
                "</strong>"
            )
            .openOn(map);


    }catch(error){

        console.error(error);

        alert(
            "Erreur pendant la recherche."
        );

    }

}


/* ================= ENTER SEARCH ================= */

document
.getElementById("searchInput")
.addEventListener(
    "keydown",
    function(event){

        if(event.key==="Enter"){
            searchCity();
        }

    }
);


/* ================= GEOLOCATION ================= */

function useMyLocation(){

    if(!navigator.geolocation){

        alert(
            "La géolocalisation n'est pas disponible."
        );

        return;

    }


    navigator.geolocation.getCurrentPosition(

        async function(position){

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            if(
                lat < 18.85 ||
                lat > 37.30 ||
                lon < -8.75 ||
                lon > 11.95
            ){

                alert(
                    "Votre position détectée est hors de l'Algérie."
                );

                return;

            }


            let name =
                "Ma position — Algérie";


            try{

                const url =
                "https://nominatim.openstreetmap.org/reverse" +
                "?format=json" +
                "&lat=" +
                lat +
                "&lon=" +
                lon;


                const response =
                    await fetch(url);


                const data =
                    await response.json();


                if(
                    data &&
                    data.display_name
                ){

                    name =
                        data.display_name;

                }

            }catch(e){

                console.log(e);

            }


            loadWeather(
                lat,
                lon,
                name
            );


            map.setView(
                [lat,lon],
                10
            );


            L.marker(
                [lat,lon]
            )
            .addTo(map)
            .bindPopup(
                "📍 Votre position"
            )
            .openPopup();

        },

        function(error){

            alert(
                "Impossible d'obtenir votre position. Vérifiez l'autorisation de localisation du navigateur."
            );

        },

        {
            enableHighAccuracy:true,
            timeout:10000,
            maximumAge:60000
        }

    );

}


/* ================= RESET ALGERIA ================= */

function resetAlgeria(){

    map.fitBounds(
        ALGERIA_BOUNDS
    );

}


/* ================= NASA KEY ================= */

function saveNASAKey(){

    const input =
        document.getElementById(
            "nasaKey"
        );


    const key =
        input.value.trim();


    if(!key){

        alert(
            "Veuillez entrer votre NASA FIRMS MAP_KEY."
        );

        return;

    }


    localStorage.setItem(
        "ingenious_nasa_key",
        key
    );


    NASA_MAP_KEY=key;


    alert(
        "NASA FIRMS MAP_KEY enregistrée."
    );


    loadFireData();

}


/* ================= LOAD SAVED KEY ================= */

function loadSavedKey(){

    const input =
        document.getElementById(
            "nasaKey"
        );


    input.value =
        NASA_MAP_KEY;

}


/* ================= AUTO REFRESH ================= */

/*
   NASA FIRMS data and weather are refreshed
   periodically.
*/

setInterval(
    function(){

        loadWeather();

        loadFireData();

        loadRadar();

    },
    15 * 60 * 1000
);


/* ================= START APPLICATION ================= */

async function startApp(){

    loadSavedKey();


    await loadWeather(
        DEFAULT_LOCATION.lat,
        DEFAULT_LOCATION.lon,
        DEFAULT_LOCATION.name
    );


    await loadRadar();


    await loadFireData();

}


startApp();

</script>

